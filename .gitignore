dist/
build/
.next/
out/

# Runtime logs (regenerated on every run)
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Test / coverage output
coverage/

# Python (if any tooling lands here)
__pycache__/
*.py[cod]
.venv/
venv/

# Editor / OS
.DS_Store
Thumbs.db
.vscode/
.idea/
.claude/

# Factory manifests hold device secrets and claim codes; they never enter git.
manifests/
