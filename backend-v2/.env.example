# Copy to .env. src/config.ts is the only place that reads these.

NODE_ENV=development
HOST=127.0.0.1
API_PORT=3100
VOICE_PORT=3101
LOG_LEVEL=info

# PostgreSQL with pgvector. pgvector 0.7+ stores embeddings as halfvec; older
# servers (0.6) fall back to vector automatically at migration time.
DATABASE_URL=postgres://littlebuddy:littlebuddy@localhost:5432/littlebuddy_v2

# At least 32 characters each in production; the defaults are refused there.
JWT_SECRET=dev-only-jwt-secret-change-me-0123456789
DEVICE_KEK=dev-only-device-kek-change-me-0123456789

# live = OpenAI + ElevenLabs; fake = deterministic stand-ins (no keys, no cost).
GATEWAY=fake

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
OPENAI_REPLY_MODEL=gpt-5.6-sol
OPENAI_FAST_MODEL=gpt-5.6-luna
OPENAI_BACKGROUND_MODEL=gpt-5.6-sol
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Sent only when set: reasoning models accept it, others reject it.
OPENAI_REPLY_EFFORT=low
OPENAI_FAST_EFFORT=none
OPENAI_BACKGROUND_EFFORT=low
OPENAI_SERVICE_TIER=

ELEVENLABS_API_KEY=
ELEVENLABS_BASE_URL=https://api.elevenlabs.io
ELEVENLABS_STT_MODEL=scribe_v2
# Streaming recognition while the child talks; batch Scribe stays as the fallback.
ELEVENLABS_STT_STREAMING=1
ELEVENLABS_STT_REALTIME_MODEL=scribe_v2_realtime
ELEVENLABS_TTS_MODEL=eleven_v4_turbo
ELEVENLABS_TTS_FALLBACK_MODEL=eleven_flash_v2_5
# 1 when the TTS model performs [whispers]-style tags instead of reading them.
ELEVENLABS_AUDIO_TAGS=1

# Development conveniences, refused in production.
ALLOW_TEXT_TURNS=1
EMAIL_DEV_ECHO=1

# Comma-separated OAuth client ids whose ID tokens the API accepts.
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=
