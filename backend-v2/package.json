{
  "name": "little-buddy-backend-v2",
  "private": true,
  "description": "Little Buddy backend v2: voice service, Parent API and workers, per the technical proposal",
  "type": "module",
  "engines": {
    "node": ">=23.6"
  },
  "scripts": {
    "dev": "node src/bin/dev.ts",
    "dev:lite": "node src/bin/dev-lite.ts",
    "api": "node src/bin/api.ts",
    "voice": "node src/bin/voice.ts",
    "worker": "node src/bin/worker.ts",
    "migrate": "node src/bin/migrate.ts",
    "seed": "node src/bin/seed.ts",
    "provision": "node src/bin/provision.ts",
    "toy": "node src/bin/toy.ts",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.ts\"",
    "test:unit": "node --test \"test/unit/*.test.ts\"",
    "typecheck": "tsc --noEmit -p .",
    "smoke:live": "node src/bin/live-smoke.ts",
    "eval": "node eval/run.ts"
  },
  "dependencies": {
    "fastify": "^5.12.7",
    "pg": "^8.23.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "@electric-sql/pglite-pgvector": "^0.0.14",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "typescript": "~5.9"
  }
}
