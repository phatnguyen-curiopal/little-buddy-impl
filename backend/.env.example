# Little Buddy backend. Every value here is the development default; the
# server refuses to boot in production while a default secret is left in.

# --- Server ---------------------------------------------------------------
NODE_ENV=development
PORT=3000
# Empty listens on every interface; 127.0.0.1 behind a reverse proxy
HOST=
LOG_LEVEL=info
# Proxy hops in front: 1 behind nginx, 2 behind Cloudflare + nginx, so req.ip
# is the client, not the proxy
TRUST_PROXY=0

# --- Database and Redis ---------------------------------------------------
# Start them from the repo root with: docker compose up -d
DATABASE_URL=postgres://littlebuddy:littlebuddy@localhost:5432/littlebuddy
REDIS_URL=redis://localhost:6379/0

# --- Auth secrets ---------------------------------------------------------
# Refused in production while they are the defaults or under 32 chars.
JWT_SECRET=dev-jwt-secret-change-me
ADMIN_TOKEN=dev-admin-token-change-me
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=30
SCRYPT_COST=32768

# --- Devices --------------------------------------------------------------
# DEVICE_AUTH=off skips signature checks in local dev only (refused in
# production). DEVICE_KEK encrypts device secrets at rest; the placeholder
# is refused in production.
DEVICE_AUTH=on
DEVICE_KEK=CHANGE_ME
DEVICE_CLOCK_SKEW_SEC=300
DEVICE_NONCE_TTL_SEC=900
DEVICE_HEARTBEAT_SEC=60
DEVICE_HEARTBEAT_UNCLAIMED_SEC=5
DEVICE_AUTH_FAIL_LIMIT=30

# --- Credits and turns ----------------------------------------------------
WELCOME_CREDITS=10
# At most 196 with PROVIDER_MODE=brain: the brain takes 6 MB of 16 kHz PCM16.
TURN_MAX_SEC=120
CONVERSATION_IDLE_SEC=300

# --- Conversation brain ---------------------------------------------------
# mock answers with canned lines and needs nothing else; brain calls the
# brain service (brain/) for speech, memory and the model.
PROVIDER_MODE=mock
BRAIN_URL=http://127.0.0.1:8080
# Must equal BRAIN_TOKEN in brain/.env. Refused in production (brain mode)
# while it is the default or under 32 chars.
BRAIN_TOKEN=dev-brain-token-change-me
# Longest wait for one answer; the turn fails with a canned line after it.
BRAIN_TIMEOUT_MS=45000
# The web toy lets a parent's browser play a claimed toy (reveals the device
# secret to the owner). Default on outside production, off in production.
WEB_TOY=on

# --- Payments -------------------------------------------------------------
# demo marks purchases paid on request (refused in production); disabled
# turns purchases off.
PAYMENT_PROVIDER=demo
