# Server
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Stores. Start them from the repo root with: docker compose up -d
DATABASE_URL=postgres://littlebuddy:littlebuddy@localhost:5432/littlebuddy
REDIS_URL=redis://localhost:6379/0

# Secrets. These defaults are refused outside NODE_ENV=development/test.
JWT_SECRET=dev-jwt-secret-change-me
ADMIN_TOKEN=dev-admin-token-change-me

# Parent auth
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=30
SCRYPT_COST=32768

# Device auth. DEVICE_AUTH=off skips signature checks in local dev only and is
# refused in production. DEVICE_KEK encrypts device secrets at rest; the
# placeholder is refused in production.
DEVICE_AUTH=on
DEVICE_KEK=CHANGE_ME
DEVICE_CLOCK_SKEW_SEC=300
DEVICE_NONCE_TTL_SEC=900
DEVICE_HEARTBEAT_SEC=60
DEVICE_HEARTBEAT_UNCLAIMED_SEC=5
DEVICE_AUTH_FAIL_LIMIT=30

# Turns and credits. Only the mock pipeline exists for now.
PROVIDER_MODE=mock
WELCOME_CREDITS=10
TURN_MAX_SEC=120
CONVERSATION_IDLE_SEC=300

# Buying credits. demo marks purchases paid on request (refused in
# production); disabled turns purchases off.
PAYMENT_PROVIDER=demo

# Set to 1 behind nginx/pm2 so req.ip is the client, not the proxy
TRUST_PROXY=0
