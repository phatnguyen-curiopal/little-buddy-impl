{
  "name": "littlebuddy-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.6.0"
  },
  "scripts": {
    "dev": "node --watch --env-file=.env server.js",
    "start": "node --env-file=.env server.js",
    "pretest": "node --import ./tests/helpers/env.js scripts/check_services.js",
    "test": "node --test --test-concurrency=1 --import ./tests/helpers/env.js \"tests/**/*.test.js\"",
    "test:unit": "node --test --import ./tests/helpers/env.js \"tests/unit/**/*.test.js\"",
    "migrate": "node --env-file=.env scripts/migrate.js",
    "seed": "node --env-file=.env scripts/seed_demo.js",
    "provision": "node --env-file=.env scripts/provision_batch.js",
    "e2e": "node --env-file=.env scripts/e2e_device_flow.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "ioredis": "^5.6.0",
    "jose": "^6.0.0",
    "pg": "^8.16.0",
    "ws": "^8.18.0"
  }
}
