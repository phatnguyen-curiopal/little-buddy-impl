# =============================================================================
# Little Buddy brain: STT, memory, prompt, LLM and TTS behind one internal API.
# Rationale for each value: README.md. Keys never leave the brain.
# =============================================================================

# --- 1. Service ---------------------------------------------------------------

# Binds 127.0.0.1 only; the backend calls it with BRAIN_TOKEN.
PORT=8080
# Shared with the backend's BRAIN_TOKEN. Production refuses the default.
BRAIN_TOKEN=
DATABASE_URL=postgres://littlebuddy:littlebuddy@localhost:5432/littlebuddy_brain
# Whole-turn deadline; keep it under the backend's BRAIN_TIMEOUT_MS.
TURN_TIMEOUT_MS=40000

# --- 2. API keys ----------------------------------------------------------------

# Needed whenever memory is on (embeddings, extractors), whatever LLM_PROVIDER is.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
QWEN_API_KEY=
# Required: STT and TTS.
ELEVENLABS_API_KEY=

# --- 3. LLM ---------------------------------------------------------------------

LLM_ENABLED=1
# openai | anthropic | qwen
LLM_PROVIDER=openai
OPENAI_MODEL=gpt-5.6-sol
ANTHROPIC_MODEL=claude-opus-5
QWEN_MODEL=qwen-flash-character
# DashScope workspace endpoint (regional, no default).
QWEN_BASE_URL=
LLM_MAX_TOKENS=1024
# Qwen-only cap; replies are read aloud to a child.
QWEN_MAX_TOKENS=1024
# Empty = built-in persona. Set = used verbatim (the emotion-tag rule is still appended).
LLM_SYSTEM_PROMPT=
# Anthropic always sends it (default low); OpenAI only when set; ignored by Qwen.
LLM_EFFORT=medium
# Anthropic only: disabled | adaptive.
LLM_THINKING=disabled
# Empty = field not sent. Reasoning models reject these with a 400.
LLM_TEMPERATURE=
LLM_PRESENCE_PENALTY=
LLM_FREQUENCY_PENALTY=
# OpenAI only. fast = quicker and steadier, twice the token price.
LLM_SERVICE_TIER=fast
# OpenAI only: empty | score | block. score logs flagged categories, never blocks.
LLM_MODERATION=score
# 0 = unique prompt_cache_key per request (OpenAI), for variety experiments only.
LLM_CACHE=1
# Question/answer pairs of this conversation sent with each turn.
HISTORY_MAX_TURNS=12

# --- 4. Speech (ElevenLabs, batch) -------------------------------------------

# Empty = scribe_v2 (realtime models are refused).
ELEVENLABS_STT_MODEL=
# Send trusted familiar names as recognition hints (+20% STT cost).
STT_KEYTERMS=1
# Above 100 every request bills at least 20 seconds.
STT_KEYTERMS_MAX=10
# 0 = no [laughter]-style tags; a mouse click once became a turn.
STT_AUDIO_EVENTS=0
# 1 = drop filler words and stutters.
STT_NO_VERBATIM=1
# 0 = zero retention; needs an enterprise or trial tier or every request fails.
STT_LOGGING=1
TTS_ENABLED=1
TTS_MODEL=eleven_flash_v2_5
# Must be pcm_*; the toy plays raw PCM16.
TTS_OUTPUT_FORMAT=pcm_16000

# --- 5. Memory (pgvector, text-embedding-3-large 3072 dims) ------------------

MEMORY_ENABLED=1
# both | summary | verbatim: which retrieved layers ride the prompt.
MEMORY_RETRIEVAL=summary
# Max wait for retrieval before the reply goes without the slow legs.
MEMORY_WAIT_MS=5000
MEMORY_TOP_K=4
MEMORY_MIN_SCORE=0.2
# Skip storing an exchange this similar to one already stored.
MEMORY_DEDUPE_SCORE=0.97
# 1 = each verbatim hit brings its conversation along.
MEMORY_CONTEXT=1
MEMORY_CONTEXT_MIN_SCORE=0.15
# Learn familiar names (friends, pets, family) with a small extractor call.
MEMORY_NAMES=1
MEMORY_NAMES_MODEL=gpt-5.6-luna
# Separate exchanges a name must be heard in before it may affect other text.
MEMORY_NAME_TRUST=2
# Per-name notes, newest MEMORY_NAME_CONTEXTS conversations.
MEMORY_NAME_CONTEXT=1
MEMORY_NAME_CONTEXTS=3
# Correct misheard names on voice turns before searching.
MEMORY_NAME_FIX=1
# Durable facts about the child (likes, dislikes, fears, family).
MEMORY_PROFILE=1
# Empty = MEMORY_NAMES_MODEL.
MEMORY_PROFILE_MODEL=
MEMORY_PROFILE_TOP=10
# Rolling per-conversation summary, kept as numbered points.
MEMORY_SUMMARY=1
MEMORY_SUMMARY_POINTS=8
MEMORY_SUMMARY_TOP=4
MEMORY_SUMMARY_MIN_SCORE=0.2
# Newest conversations shown every turn, by time not similarity. 0 = off.
MEMORY_RECENT=3

# --- 6. Bot life ------------------------------------------------------------------

# Buddy's backstory, diary and daily mood (seed with npm run seed:botlife).
BOT_LIFE_ENABLED=1
# 1 = add the mood band's name and description under the number.
BOT_MOOD_FEEL=

# --- 7. Debug (dev only: these hold children's words, refused in production) --

# Full prompt and reply of every turn.
LLM_LOG_FILE=
# Directory for each voice turn's WAV.
STT_DUMP_WAV=

# --- 8. Test seams (leave empty outside tests) ----------------------------------

OPENAI_BASE_URL=
ANTHROPIC_BASE_URL=
ELEVENLABS_BASE_URL=
